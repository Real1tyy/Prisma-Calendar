{
	"openapi": "3.0.3",
	"info": {
		"title": "Matej Vavro Productivity plugin API",
		"version": "1.0.0",
		"description": "The routes Obsidian plugins call directly. Generated from the billing worker's Zod schemas; never edit by hand."
	},
	"servers": [
		{
			"url": "https://api.matejvavroproductivity.com"
		}
	],
	"paths": {
		"/api/license/verify": {
			"post": {
				"operationId": "verifyLicense",
				"summary": "Activate or re-verify this device against a licence key, returning a signed offline-grace token.",
				"description": "Semantics a schema can't carry live in `docs/license-verify-contract.md`.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LicenseVerifyRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Verified; `code` is always `OK`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/LicenseVerifySuccess"
								}
							}
						}
					},
					"400": {
						"description": "Body failed the request schema.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ValidationError"
								}
							}
						}
					},
					"401": {
						"description": "`KEY_INVALID_OR_REVOKED`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/LicenseError"
								}
							}
						}
					},
					"403": {
						"description": "`ENTITLEMENT_INACTIVE` or `SEAT_LIMIT_REACHED`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/LicenseError"
								}
							}
						}
					},
					"500": {
						"description": "`INTERNAL_ERROR`.",
						"content": {
							"application/json": {
								"schema": {
									"oneOf": [
										{
											"$ref": "#/components/schemas/LicenseError"
										},
										{
											"$ref": "#/components/schemas/ErrorMessage"
										}
									]
								}
							}
						}
					}
				}
			}
		},
		"/api/license/deactivate": {
			"post": {
				"operationId": "deactivateLicense",
				"summary": "Release this device's seat on a licence key. Idempotent.",
				"description": "Semantics a schema can't carry live in `docs/license-verify-contract.md`.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LicenseDeactivateRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "`OK`, or `DEVICE_NOT_FOUND` when there was no live seat.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/LicenseDeactivateResult"
								}
							}
						}
					},
					"400": {
						"description": "Body failed the request schema.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ValidationError"
								}
							}
						}
					},
					"401": {
						"description": "`KEY_INVALID_OR_REVOKED`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/LicenseError"
								}
							}
						}
					},
					"500": {
						"description": "`INTERNAL_ERROR`.",
						"content": {
							"application/json": {
								"schema": {
									"oneOf": [
										{
											"$ref": "#/components/schemas/LicenseError"
										},
										{
											"$ref": "#/components/schemas/ErrorMessage"
										}
									]
								}
							}
						}
					}
				}
			}
		},
		"/api/feedback/plugin": {
			"post": {
				"operationId": "submitPluginFeedback",
				"summary": "Submit a bug report or feature request from inside a plugin.",
				"description": "Semantics a schema can't carry live in `docs/plugin-feedback-contract.md`.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/PluginFeedbackRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Accepted (including a deduplicated retry).",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PluginFeedbackSuccess"
								}
							}
						}
					},
					"400": {
						"description": "Body failed the request schema, or an attachment failed the byte-level checks.",
						"content": {
							"application/json": {
								"schema": {
									"oneOf": [
										{
											"$ref": "#/components/schemas/ValidationError"
										},
										{
											"$ref": "#/components/schemas/ErrorMessage"
										}
									]
								}
							}
						}
					},
					"413": {
						"description": "Declared `Content-Length` over the route's cap.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorMessage"
								}
							}
						}
					},
					"500": {
						"description": "Unexpected failure; retryable.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorMessage"
								}
							}
						}
					}
				}
			}
		},
		"/api/review": {
			"post": {
				"operationId": "submitReview",
				"summary": "Submit a half-star rating, with optional text, for a plugin.",
				"description": "Semantics a schema can't carry live in `docs/review-submit-contract.md`.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ReviewRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Deduplicated retry of an already-stored review.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewSuccess"
								}
							}
						}
					},
					"201": {
						"description": "Stored.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewSuccess"
								}
							}
						}
					},
					"400": {
						"description": "`MALFORMED_JSON`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewError"
								}
							}
						}
					},
					"413": {
						"description": "`BODY_TOO_LARGE`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewError"
								}
							}
						}
					},
					"415": {
						"description": "`UNSUPPORTED_MEDIA_TYPE`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewError"
								}
							}
						}
					},
					"422": {
						"description": "`SCHEMA_INVALID` or `LICENSE_INVALID`.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewError"
								}
							}
						}
					},
					"503": {
						"description": "`DEPENDENCY_UNAVAILABLE`; retryable.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewError"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"LicenseVerifyRequest": {
				"type": "object",
				"properties": {
					"licenseKey": {
						"type": "string",
						"minLength": 1
					},
					"deviceId": {
						"type": "string",
						"minLength": 1
					},
					"deviceName": {
						"type": "string"
					},
					"pluginVersion": {
						"type": "string"
					},
					"obsidianVersion": {
						"type": "string"
					},
					"platform": {
						"type": "string"
					}
				},
				"required": [
					"licenseKey",
					"deviceId"
				],
				"additionalProperties": true
			},
			"LicenseVerifySuccess": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string",
						"enum": [
							"OK"
						]
					},
					"token": {
						"type": "string"
					},
					"expiresAt": {
						"type": "string"
					},
					"productId": {
						"type": "string"
					},
					"productName": {
						"type": "string"
					},
					"entitlementStatus": {
						"type": "string",
						"enum": [
							"active",
							"trialing",
							"canceled",
							"expired",
							"past_due",
							"paused",
							"incomplete",
							"active_canceled",
							"trialing_canceled"
						]
					},
					"currentPeriodEnd": {
						"type": "string",
						"nullable": true
					},
					"cancelAt": {
						"type": "string",
						"nullable": true
					},
					"trialEndsAt": {
						"type": "string",
						"nullable": true
					},
					"activations": {
						"type": "object",
						"properties": {
							"current": {
								"type": "integer"
							},
							"limit": {
								"type": "integer"
							}
						},
						"required": [
							"current",
							"limit"
						],
						"additionalProperties": true
					}
				},
				"required": [
					"code",
					"token",
					"expiresAt",
					"productId",
					"productName",
					"entitlementStatus",
					"currentPeriodEnd",
					"cancelAt",
					"trialEndsAt",
					"activations"
				],
				"additionalProperties": true
			},
			"LicenseDeactivateRequest": {
				"type": "object",
				"properties": {
					"licenseKey": {
						"type": "string",
						"minLength": 1
					},
					"deviceId": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"licenseKey",
					"deviceId"
				],
				"additionalProperties": true
			},
			"LicenseDeactivateResult": {
				"anyOf": [
					{
						"type": "object",
						"properties": {
							"code": {
								"type": "string",
								"enum": [
									"OK"
								]
							},
							"deactivated": {
								"type": "boolean",
								"enum": [
									true
								]
							}
						},
						"required": [
							"code",
							"deactivated"
						],
						"additionalProperties": true
					},
					{
						"type": "object",
						"properties": {
							"code": {
								"type": "string",
								"enum": [
									"DEVICE_NOT_FOUND"
								]
							},
							"error": {
								"type": "string"
							},
							"deactivated": {
								"type": "boolean",
								"enum": [
									false
								]
							}
						},
						"required": [
							"code",
							"error",
							"deactivated"
						],
						"additionalProperties": true
					}
				]
			},
			"LicenseError": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string",
						"enum": [
							"KEY_INVALID_OR_REVOKED",
							"ENTITLEMENT_INACTIVE",
							"SEAT_LIMIT_REACHED",
							"DEVICE_NOT_FOUND",
							"INTERNAL_ERROR"
						]
					},
					"error": {
						"type": "string"
					},
					"activations": {
						"type": "object",
						"properties": {
							"current": {
								"type": "integer"
							},
							"limit": {
								"type": "integer"
							}
						},
						"required": [
							"current",
							"limit"
						],
						"additionalProperties": true
					}
				},
				"required": [
					"code",
					"error"
				],
				"additionalProperties": true
			},
			"PluginFeedbackRequest": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"feedback"
						]
					},
					"type": {
						"type": "string",
						"enum": [
							"bug",
							"feature",
							"question",
							"general"
						]
					},
					"text": {
						"type": "string",
						"maxLength": 5000,
						"description": "Server-enforced: must be non-empty unless `screenshots` carries at least one image. Trimmed before the check."
					},
					"pluginId": {
						"type": "string",
						"enum": [
							"prisma-calendar",
							"periodix-planner",
							"fusion-goals",
							"notes-manipulator",
							"bases-improvements",
							"nexus-properties",
							"people-manager",
							"page-header-manager",
							"core-finance",
							"reality-custom"
						]
					},
					"pluginVersion": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"obsidianVersion": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"platform": {
						"type": "string",
						"enum": [
							"macos",
							"windows",
							"linux",
							"ios",
							"android",
							"unknown"
						]
					},
					"clientId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"licenseKey": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"health": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string"
								},
								"label": {
									"type": "string"
								},
								"status": {
									"type": "string",
									"enum": [
										"ok",
										"warn",
										"fail"
									]
								},
								"detail": {
									"type": "string"
								}
							},
							"required": [
								"id",
								"label",
								"status",
								"detail"
							],
							"additionalProperties": false
						},
						"minItems": 1
					},
					"debugBundle": {
						"type": "object",
						"properties": {
							"capturedAt": {
								"type": "string"
							},
							"windowMs": {
								"type": "integer"
							},
							"environment": {
								"type": "object",
								"properties": {
									"pluginId": {
										"type": "string"
									},
									"pluginVersion": {
										"type": "string"
									},
									"obsidianVersion": {
										"type": "string"
									},
									"platform": {
										"type": "string"
									}
								},
								"required": [
									"pluginId",
									"pluginVersion",
									"obsidianVersion",
									"platform"
								],
								"additionalProperties": false
							},
							"counts": {
								"type": "object",
								"properties": {
									"buffered": {
										"type": "integer"
									},
									"warnings": {
										"type": "integer"
									},
									"errors": {
										"type": "integer"
									}
								},
								"required": [
									"buffered",
									"warnings",
									"errors"
								],
								"additionalProperties": false
							},
							"problems": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"seq": {
											"type": "integer"
										},
										"ts": {
											"type": "integer"
										},
										"level": {
											"type": "string",
											"enum": [
												"debug",
												"info",
												"warn",
												"error"
											]
										},
										"scope": {
											"type": "string"
										},
										"message": {
											"type": "string"
										},
										"data": {}
									},
									"required": [
										"seq",
										"ts",
										"level",
										"scope",
										"message"
									],
									"additionalProperties": false
								}
							},
							"recent": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"seq": {
											"type": "integer"
										},
										"ts": {
											"type": "integer"
										},
										"level": {
											"type": "string",
											"enum": [
												"debug",
												"info",
												"warn",
												"error"
											]
										},
										"scope": {
											"type": "string"
										},
										"message": {
											"type": "string"
										},
										"data": {}
									},
									"required": [
										"seq",
										"ts",
										"level",
										"scope",
										"message"
									],
									"additionalProperties": false
								}
							}
						},
						"required": [
							"capturedAt",
							"windowMs",
							"environment",
							"counts",
							"problems",
							"recent"
						],
						"additionalProperties": false
					},
					"screenshots": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"mimeType": {
									"type": "string",
									"minLength": 1,
									"maxLength": 128
								},
								"dataBase64": {
									"type": "string",
									"minLength": 1,
									"maxLength": 2800000
								},
								"byteSize": {
									"type": "integer",
									"exclusiveMinimum": true,
									"minimum": 0
								}
							},
							"required": [
								"mimeType",
								"dataBase64",
								"byteSize"
							],
							"additionalProperties": false
						},
						"maxItems": 8
					}
				},
				"required": [
					"kind",
					"type",
					"text",
					"pluginId",
					"pluginVersion",
					"obsidianVersion",
					"platform",
					"clientId"
				],
				"additionalProperties": false
			},
			"PluginFeedbackSuccess": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean",
						"enum": [
							true
						]
					}
				},
				"required": [
					"success"
				],
				"additionalProperties": true
			},
			"ReviewRequest": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"review"
						]
					},
					"rating": {
						"type": "number",
						"description": "Server-enforced: a half-star value, i.e. a multiple of 0.5 from 0.5 to 5 inclusive."
					},
					"text": {
						"type": "string",
						"maxLength": 10000
					},
					"pluginId": {
						"type": "string",
						"enum": [
							"prisma-calendar",
							"periodix-planner",
							"fusion-goals",
							"notes-manipulator",
							"bases-improvements",
							"nexus-properties",
							"people-manager",
							"page-header-manager",
							"core-finance",
							"reality-custom"
						]
					},
					"pluginVersion": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"obsidianVersion": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"platform": {
						"type": "string",
						"enum": [
							"macos",
							"windows",
							"linux",
							"ios",
							"android",
							"unknown"
						]
					},
					"clientId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"licenseKey": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					}
				},
				"required": [
					"kind",
					"rating",
					"pluginId",
					"pluginVersion",
					"obsidianVersion",
					"platform",
					"clientId"
				],
				"additionalProperties": false
			},
			"ReviewSuccess": {
				"type": "object",
				"properties": {
					"ok": {
						"type": "boolean",
						"enum": [
							true
						]
					},
					"id": {
						"type": "string"
					},
					"deduplicated": {
						"type": "boolean"
					}
				},
				"required": [
					"ok",
					"id",
					"deduplicated"
				],
				"additionalProperties": true
			},
			"ReviewError": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string",
						"enum": [
							"UNSUPPORTED_MEDIA_TYPE",
							"BODY_TOO_LARGE",
							"MALFORMED_JSON",
							"SCHEMA_INVALID",
							"LICENSE_INVALID",
							"DEPENDENCY_UNAVAILABLE"
						]
					},
					"error": {
						"type": "string"
					}
				},
				"required": [
					"code",
					"error"
				],
				"additionalProperties": true
			},
			"ValidationError": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean",
