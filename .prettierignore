# Byte-synced by the agenticd harness — these are edit-blocked, so a prettier rewrite
# is both impossible to apply and permanent churn in `format:check`. Their formatting is
# the bundle's concern, not ours. Authoritative list: docs/AGENTICD.md. (Most managed
# files are .py/.toml/.md that prettier ignores anyway; these are the paths where a
# future bundle could ship something prettier DOES claim.)
lefthook.yml
.config/tasks/harness/
tools/wt-cli/

# Python tool virtualenvs. Gitignored build output that prettier would otherwise walk
# (it does not read .gitignore), leaving `format:check` permanently red on
# dist-info/*.json it has no business rewriting.
**/.venv/

# Harness + editor state under .claude/ (settings, session data) and .agentic/ (the
# byte-synced manifest, telemetry, gate logs). Machine-written JSON, byte-synced or
# tool-owned — not ours to restyle.
.claude/
.agentic/

# Showrunner recording output (mp4 + poster + manifest.json), regenerated per run.
tools/showrunner/out/

# Approval/snapshot files are machine-generated byte-for-byte outputs that
# tests compare against at runtime. Prettier reformatting them (tabs vs
# spaces, key ordering) breaks the equality check and makes the suite flaky.
# Humans review these via the diff at write-time, not the formatter on commit.
**/__snapshots__/**

# Visual regression fixtures are generated at test time and consumed by
# pixel-diff assertions. Reformatting them changes byte output and trips
# the diff. Treated the same as snapshot files above.
**/tests/visual/fixtures/**

# Vendored Obsidian community themes, copied verbatim for the preview tool's
# theme picker. They are third-party artifacts we don't author, and some trip
# Prettier's CSS parser. Keep them byte-for-byte as shipped upstream.
tools/obsidian-preview/public/themes/**

# Vendored Obsidian app stylesheet — extracted byte-for-byte from the installed
# app asar by `mise run preview:refresh-css`. Reformatting it makes every
# refresh a spurious mega-diff against the generator's output.
tools/obsidian-preview/public/obsidian-app.css

# Cross-plugin API contracts, emitted by `contract:emit` (the release script
# regenerates them alongside the version bump). JSON.stringify always expands
# arrays, so the generator's output can never match Prettier's collapsed form —
# a formatted contract is red again the next time it is regenerated. Generated
# output is not ours to restyle; the drift checker is what reviews it.
*/api-contract.json
